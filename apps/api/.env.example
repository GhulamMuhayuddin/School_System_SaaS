# Copy to apps/api/.env. Never commit the real file.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# In production this must be the exact https:// address(es) of the web app, comma separated (no *).
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
# Number of proxies in front of the API when TRUST_PROXY=true (Caddy: 1, Vercel -> Render: 2).
TRUST_PROXY_HOPS=1

# Runtime connection: restricted role "nexora_app" (cannot bypass Row Level Security).
DATABASE_URL=postgresql://nexora_app:nexora_app_dev_password@localhost:5432/nexora_school
# Owner connection: used ONLY for migrations, RLS script and seeding.
DIRECT_URL=postgresql://nexora:nexora_dev_password@localhost:5432/nexora_school

# Seed (required by `pnpm --filter @nexora/api db:seed`). Choose your own strong values.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
# Optional demo school for development only.
SEED_DEMO_SCHOOL=false
SEED_DEMO_ADMIN_EMAIL=
SEED_DEMO_ADMIN_PASSWORD=

# ---- Authentication (Phase 3) ----
# REQUIRED. At least 32 random characters. Generate one (Windows cmd):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
# Session length without / with "Remember me" (refresh tokens rotate; this is the absolute end).
SESSION_HOURS=24
SESSION_DAYS_REMEMBER=30
# Must be true in production (HTTPS-only cookies).
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RESET_TOKEN_MINUTES=60
# Base URL of the web app, used to build the password-reset link.
APP_BASE_URL=http://localhost:5173

# ---- Email ----
# console = only prints the email (reset link) in the API log: development only, nothing is sent.
# smtp    = really sends; fill SMTP_* below. Required in production.
EMAIL_TRANSPORT=console
EMAIL_FROM=Nexora School ERP <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
