# Example nginx site for Nexora School ERP (Phase 19B). Copy, replace the three CHANGE-ME values, then `nginx -t`.
# The web app is the folder produced by `pnpm build` (apps/web/dist); the API runs on 127.0.0.1:4000 with TRUST_PROXY=true.

server {
  listen 80;
  server_name school.example.pk;                               # CHANGE-ME
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name school.example.pk;                               # CHANGE-ME
  ssl_certificate     /etc/letsencrypt/live/school.example.pk/fullchain.pem;   # CHANGE-ME
  ssl_certificate_key /etc/letsencrypt/live/school.example.pk/privkey.pem;     # CHANGE-ME
  ssl_protocols TLSv1.2 TLSv1.3;

  root /var/www/nexora/web;
  index index.html;
  client_max_body_size 2m;                                     # the API itself limits JSON to 1 MB

  # Same headers as apps/web/public/_headers. `always` keeps them on error pages too.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
  add_header Cross-Origin-Opener-Policy "same-origin" always;
  server_tokens off;

  location /api/ {
    proxy_pass http://127.0.0.1:4000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # nginx drops add_header from the server block inside a location that sets its own; the API sets its own security headers (helmet).
  }

  location /assets/ {                                          # file names contain a hash, so they can be cached for a year
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  location / {                                                 # single-page app: unknown paths open index.html
    add_header Cache-Control "no-cache" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    try_files $uri /index.html;
  }
}
