# Copy to .env.production (same folder as docker-compose.prod.yml). NEVER commit the real file, never e-mail it.
# Replace every CHANGE-ME. Generate secrets on any machine with Node:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Public address of the site, no https://, no slash. Its DNS A record must point to this server BEFORE you start Caddy.
DOMAIN=school.example.pk                                   # CHANGE-ME

# Database. Use long random values; avoid the characters @ : / ? # % in passwords (they sit inside a connection URL).
POSTGRES_PASSWORD=CHANGE-ME-long-random
NEXORA_APP_PASSWORD=CHANGE-ME-another-long-random

# 48+ random characters (the API refuses to start with fewer than 32).
JWT_ACCESS_SECRET=CHANGE-ME-48-plus-random-characters

# First platform (super) admin, created by the migrate job. Strong password, change it after the first login.
SEED_SUPERADMIN_EMAIL=CHANGE-ME@example.pk
SEED_SUPERADMIN_PASSWORD=CHANGE-ME-strong-password

# Real e-mail (password-reset mails). The console transport is refused in production.
EMAIL_FROM=Nexora School ERP <no-reply@school.example.pk>  # CHANGE-ME
SMTP_HOST=smtp.example.com                                 # CHANGE-ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE-ME
SMTP_PASS=CHANGE-ME

LOG_LEVEL=info
