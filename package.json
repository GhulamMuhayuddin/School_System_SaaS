{
  "name": "nexora-school-erp",
  "private": true,
  "version": "0.20.9",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "postinstall": "pnpm --filter @nexora/shared build && pnpm --filter @nexora/api db:generate",
    "dev": "pnpm --filter @nexora/web dev",
    "dev:api": "pnpm --filter @nexora/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:generate": "pnpm --filter @nexora/api db:generate",
    "db:migrate": "pnpm --filter @nexora/api db:migrate",
    "db:rls": "pnpm --filter @nexora/api db:rls",
    "db:seed": "pnpm --filter @nexora/api db:seed"
  }
}
